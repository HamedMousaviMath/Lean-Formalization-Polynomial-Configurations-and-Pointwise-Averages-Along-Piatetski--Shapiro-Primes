                                                LE.le.{0} (norm.{0} (PSPrimes.polynomialForm M d R θ f₀ f))
                                                  (HMul.hMul.{0, 0, 0} C
                                                    (HPow.hPow.{0, 0, 0} (HAdd.hAdd.{0, 0, 0} (Inv.inv.{0} ↑M) E)
                                                      (HDiv.hDiv.{0, 0, 0} 1 ↑K)))))
def PSPrimes.OrbitVNInput.{u} : Prop :=
