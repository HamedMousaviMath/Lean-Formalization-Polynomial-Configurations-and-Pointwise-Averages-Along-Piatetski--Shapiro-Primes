                                        LE.le.{0} (norm.{0} (θ n)) 1) →
                                    (∀ (x : Int), LE.le.{0} (norm.{0} (f₀ x)) 1) →
                                      (∀ (i : Fin ℓ) (x : Int), LE.le.{0} (norm.{0} (f i x)) 1) →
                                        (∀ (x : Int),
                                            LT.lt.{0} (HMul.hMul.{0, 0, 0} C₀ (HPow.hPow.{0, 0, 0} (↑M) d))
                                                (abs.{0} ↑x) →
                                              Eq.{1} (f₀ x) 0) →
                                          (∀ (i : Fin ℓ) (x : Int),
                                              LT.lt.{0} (HMul.hMul.{0, 0, 0} C₀ (HPow.hPow.{0, 0, 0} (↑M) d))
