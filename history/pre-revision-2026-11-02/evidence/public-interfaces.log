    ∃ ε,
      And (LT.lt.{0} 0 ε)
        (And (LT.lt.{0} ε 1)
          (∃ σ,
            And (LT.lt.{0} 0 σ)
              (∀ (γ : Real),
                LT.lt.{0} (HSub.hSub.{0, 0, 0} 1 ε) γ →
                  LT.lt.{0} γ 1 →
                    ∃ C,
                      And (LT.lt.{0} 0 C)
                        (∀ (X : Nat),
                          LE.le.{0} 1 X →
                            PSPrimes.PhaseBound r X (fun n => ↑(PSPrimes.discrepancyWeight γ n))
                              (HMul.hMul.{0, 0, 0} C (HPow.hPow.{0, 0, 0} (↑X) (HSub.hSub.{0, 0, 0} 1 σ)))))))
