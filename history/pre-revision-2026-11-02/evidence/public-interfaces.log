                                                  LE.le.{0} (abs.{0} (g n)) B) →
                                              PSPrimes.PhaseBound d N (fun n => ↑(g n)) (HMul.hMul.{0, 0, 0} (↑N) E) →
                                                And
                                                  (MeasureTheory.Integrable.{0, u}
                                                    (fun x =>
                                                      PSPrimes.weightedAverage g
                                                        (fun n => PSPrimes.orbitProduct.{u} P T f n x) N)
