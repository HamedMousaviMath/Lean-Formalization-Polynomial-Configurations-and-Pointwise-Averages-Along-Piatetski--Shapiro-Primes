                        ∃ C,
                          And (LT.lt.{0} 0 C)
                            (∀ (M : Nat),
                              LE.le.{0} 1 M →
                                ∀ (θ : Nat → Complex) (f₀ : Finsupp.{0, 0} Int Complex) (f : Fin ℓ → Int → Complex)
