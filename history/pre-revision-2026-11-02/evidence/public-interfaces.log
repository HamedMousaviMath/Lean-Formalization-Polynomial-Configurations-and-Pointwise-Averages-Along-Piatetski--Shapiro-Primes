                                (∀ (i : Fin ℓ), ∀ᵐ (x : X) ∂μ, LE.le.{0} (norm.{0} (f i x)) 1) →
                                  ∀ (N : Nat),
                                    LE.le.{0} 1 N →
                                      ∀ (g : Nat → Real) (B E : Real),
