                                                    (∫ (x : X),
                                                      norm.{0}
                                                        (PSPrimes.weightedAverage g
                                                          (fun n => PSPrimes.orbitProduct.{u} P T f n x) N) ∂μ)
                                                    (HMul.hMul.{0, 0, 0} (HMul.hMul.{0, 0, 0} C B)
                                                      (HPow.hPow.{0, 0, 0}
                                                        (HAdd.hAdd.{0, 0, 0} (Inv.inv.{0} ↑N) (HDiv.hDiv.{0, 0, 0} E B))
                                                        (HDiv.hDiv.{0, 0, 0} 1 ↑K))))))
