                  (∃ i, Eq.{1} (Polynomial.natDegree.{0} (P i)) d) →
                    ∃ C,
                      And (LT.lt.{0} 0 C)
                        (∀ (X : Type u) [inst : MeasurableSpace.{u} X] (μ : MeasureTheory.Measure.{u} X),
                          MeasureTheory.IsProbabilityMeasure.{u} μ →
                            ∀ (T : PSPrimes.IntegerAction.{u} X μ) (f : Fin ℓ → X → Complex),
