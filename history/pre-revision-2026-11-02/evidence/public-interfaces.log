                ∃ N₀,
                  ∀ (N : Nat),
                    LE.le.{0} N₀ N →
                      ∀ (A : Finset.{0} Int),
                        Subset.{0} A (Finset.Icc.{0} 1 ↑N) →
                          LE.le.{0} (HDiv.hDiv.{0, 0, 0} (↑N) (HPow.hPow.{0, 0, 0} (Real.log ↑N) κ))
                              ↑(Finset.card.{0} A) →
                            PSPrimes.ContainsConfiguration (PSPrimes.PolynomialFamily.polynomials P) c A))
