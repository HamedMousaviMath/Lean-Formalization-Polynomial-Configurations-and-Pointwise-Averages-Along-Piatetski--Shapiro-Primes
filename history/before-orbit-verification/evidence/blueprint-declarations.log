PSPrimes.progressionPhase_of_shaoSun (hSS : PSPrimes.ShaoSunPhaseInput) (r : ℕ) :
  1 ≤ r →
    ∃ ε,
      0 < ε ∧
        ε < 1 ∧
          ∃ σ,
            0 < σ ∧
              ∀ (γ : ℝ),
                1 - ε < γ →
                  γ < 1 →
                    ∃ C,
                      0 < C ∧
                        ∀ (Q M : ℕ),
                          1 ≤ Q →
                            1 ≤ M →
                              PSPrimes.PhaseBound r M (fun y => ↑(PSPrimes.discrepancyWeight γ (Q * y + 1)))
                                (C * ↑(Q * M) ^ (1 - σ))
PSPrimes.rescale (P : Polynomial ℤ) (q : ℤ) : Polynomial ℤ
PSPrimes.countingForm {ℓ : ℕ} (N M Q : ℕ) (R : Fin ℓ → Polynomial ℤ) (w : ℕ → ℂ) (f₀ : ℤ →₀ ℂ) (f : Fin ℓ → ℤ → ℂ) : ℂ
PSPrimes.ps_counting_comparison (hSS : PSPrimes.ShaoSunPhaseInput) (hVN : PSPrimes.FiniteVNInput) (d : ℕ) (hd : 1 ≤ d) :
  ∃ cstar,
    1 < cstar ∧
      ∃ ξ,
        0 < ξ ∧
          ∀ (ℓ : ℕ) (P : PSPrimes.PolynomialFamily ℓ),
            (∀ (i : Fin ℓ), (P.polynomials i).natDegree ≤ d) →
              (∃ i, (P.polynomials i).natDegree = d) →
                ∀ (C₀ : ℝ),
                  1 ≤ C₀ →
                    ∀ (c : ℝ),
                      1 < c →
                        c < cstar →
                          ∃ C,
                            0 < C ∧
                              ∀ (a : ℝ),
                                0 < a →
                                  a < 1 →
                                    ∃ M₀,
                                      ∀ (N Q : ℕ),
                                        1 ≤ N →
                                          1 ≤ Q →
                                            ↑Q ≤ Real.exp (Real.log ↑N ^ a) →
                                              M₀ ≤ PSPrimes.floorScale N Q d →
                                                ∀ (f₀ : ℤ →₀ ℂ) (f : Fin ℓ → ℤ → ℂ),
                                                  (∀ (x : ℤ), ‖f₀ x‖ ≤ 1) →
                                                    (∀ (i : Fin ℓ) (x : ℤ), ‖f i x‖ ≤ 1) →
                                                      (∀ (x : ℤ), C₀ * ↑N < |↑x| → f₀ x = 0) →
                                                        (∀ (i : Fin ℓ) (x : ℤ), C₀ * ↑N < |↑x| → f i x = 0) →
                                                          ‖PSPrimes.countingForm N (PSPrimes.floorScale N Q d) Q
                                                                (fun i => PSPrimes.rescale (P.polynomials i) ↑Q)
                                                                (fun n => ↑(PSPrimes.discrepancyWeight (1 / c) n)) f₀
                                                                f‖ ≤
                                                            C * ↑N ^ (-ξ)
