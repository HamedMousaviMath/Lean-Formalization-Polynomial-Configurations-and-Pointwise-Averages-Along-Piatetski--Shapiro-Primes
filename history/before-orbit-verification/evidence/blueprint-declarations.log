PSPrimes.kmtt_density_increment_normalized (hUW : PSPrimes.KMTTUnweightedInput) (hReg : PSPrimes.KMTTRegularityInput)
  (d : ℕ) :
  1 ≤ d →
    ∃ Bmax,
      1 ≤ Bmax ∧
        ∀ (ℓ : ℕ),
          1 ≤ ℓ →
            ∃ Aq Aδ,
              1 ≤ Aq ∧
                1 ≤ Aδ ∧
                  ∀ (C : ℝ),
                    1 ≤ C → ∃ Adiv p c₂, 0 < c₂ ∧ PSPrimes.KMTTDensityIncrementWitness C d ℓ Adiv Bmax Aq Aδ p c₂ 1
