PSPrimes.ps_prime_discrepancy (hSS : PSPrimes.ShaoSunPhaseInput) (hVN : PSPrimes.FiniteVNInput) (d : ℕ) (hd : 1 ≤ d) :
  ∃ cstar,
    1 < cstar ∧
      ∀ (ℓ : ℕ) (P : PSPrimes.PolynomialFamily ℓ),
        (∀ (i : Fin ℓ), (P.polynomials i).natDegree ≤ d) →
          (∃ i, (P.polynomials i).natDegree = d) →
            ∀ (C : ℝ),
              1 ≤ C →
                (∀ (i : Fin ℓ), ∀ j ≤ d, |↑((P.polynomials i).coeff j)| ≤ C) →
                  ∀ (Adiv : ℕ) (p : PSPrimes.KMTTComparisonParameters ℓ Adiv),
                    PSPrimes.PrimeProgressionMassWitness p d (1 / (10 * C * ↑(d + 1))) →
                      ∀ (c : ℝ),
                        1 < c →
                          c < cstar →
                            ∃ N₀,
                              ∀ (N : ℕ),
                                N₀ ≤ N →
                                  ∀ (Q s : ℕ) (δ : ℝ),
                                    PSPrimes.KMTTAdmissible p N Q s δ →
                                      ∀ A ⊆ PSPrimes.integerInterval N,
                                        ↑A.card = δ * ↑N →
                                          PSPrimes.NoRescaledConfiguration P.polynomials Q c A →
                                            p.c₁ * δ ^ (ℓ + 1) *
                                                PSPrimes.primeProgressionMass Q (PSPrimes.floorScale N Q d) ≤
                                              |PSPrimes.realSetCount N (PSPrimes.floorScale N Q d) Q
                                                    (fun j => PSPrimes.rescale (P.polynomials j) ↑Q)
                                                    (⇑ArithmeticFunction.vonMangoldt) A -
                                                  PSPrimes.realModelCount N (PSPrimes.floorScale N Q d) Q
                                                    (fun j => PSPrimes.rescale (P.polynomials j) ↑Q)
                                                    (⇑ArithmeticFunction.vonMangoldt) δ|
