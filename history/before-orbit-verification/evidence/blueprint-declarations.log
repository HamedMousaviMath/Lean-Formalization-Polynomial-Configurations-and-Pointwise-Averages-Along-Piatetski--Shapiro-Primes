PSPrimes.orbitProduct.{u_1} {ℓ : ℕ} {X : Type u_1} [MeasurableSpace X] {μ : MeasureTheory.Measure X}
  (P : Fin ℓ → Polynomial ℤ) (T : PSPrimes.IntegerAction X μ) (f : Fin ℓ → X → ℂ) (n : ℕ) (x : X) : ℂ
PSPrimes.weightedAverage (w : ℕ → ℝ) (z : ℕ → ℂ) (N : ℕ) : ℂ
PSPrimes.selectedAverage (S : ℕ → Prop) [DecidablePred S] (z : ℕ → ℂ) (N : ℕ) : ℂ
PSPrimes.ps_orbit_comparison.{u} (hSS : PSPrimes.ShaoSunPhaseInput) (hOR : PSPrimes.OrbitVNInput)
  (hPNT : PSPrimes.PrimeNumberTheoremInput) (d : ℕ) (hd : 1 ≤ d) :
  ∃ cstar,
    1 < cstar ∧
      ∀ (ℓ : ℕ) (P : PSPrimes.PolynomialFamily ℓ),
        (∀ (i : Fin ℓ), (P.polynomials i).natDegree ≤ d) →
          (∃ i, (P.polynomials i).natDegree = d) →
            ∀ (c : ℝ),
              1 < c →
                c < cstar →
                  ∀ (X : Type u) [inst : MeasurableSpace X] (μ : MeasureTheory.Measure X),
                    MeasureTheory.IsProbabilityMeasure μ →
                      ∀ (T : PSPrimes.IntegerAction X μ) (f : Fin ℓ → X → ℂ),
                        (∀ (i : Fin ℓ), MeasureTheory.AEStronglyMeasurable (f i) μ) →
                          (∀ (i : Fin ℓ), ∀ᵐ (x : X) ∂μ, ‖f i x‖ ≤ 1) →
                            ∀ᵐ (x : X) ∂μ,
                              Filter.Tendsto
                                (fun N =>
                                  PSPrimes.weightedAverage (PSPrimes.sparseMangoldt (1 / c))
                                      (fun n => PSPrimes.orbitProduct P.polynomials T f n x) N -
                                    PSPrimes.weightedAverage (⇑ArithmeticFunction.vonMangoldt)
                                      (fun n => PSPrimes.orbitProduct P.polynomials T f n x) N)
                                Filter.atTop (nhds 0)
